{
  "name": "buildmora",
  "version": "0.1.0",
  "private": true,
  "description": "BuildMora — Industry-level platform for students & professionals",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
